{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "api/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8001",
        "--app-dir",
        "api"
      ],
      "port": 8001
    },
    {
      "name": "cecop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/command-center",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
