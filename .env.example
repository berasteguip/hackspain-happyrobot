# Copia esto a .env y rellena. .env NUNCA se comitea.
# Contrato completo de estas variables: docs/contrato-de-datos.md §5

# --- Seguridad ---
# Secreto compartido con HappyRobot. Va en el header x-api-key de toda llamada a nuestra API.
#
# GENERALO, no lo copies de aqui. Este fichero esta comiteado en un repo PUBLICO: si dejas el
# valor de ejemplo, cualquiera que lea el repositorio tiene la llave de tu despliegue. Con
# ALLOW_REAL_CALLS=true eso significa que puede hacer sonar telefonos reales.
#   openssl rand -hex 32
# La API se NIEGA a marcar de verdad si detecta uno de los valores de ejemplo.
HR_SHARED_SECRET=GENERA-EL-TUYO-NO-USES-ESTE

# --- HappyRobot ---
HR_API_KEY=                                      # Settings > API Keys del workspace
HR_WORKFLOW_WEBHOOK=                             # URL del trigger webhook del workflow
HR_WORKFLOW_ID=                                  # slug o UUID, solo para trazas
HR_BASE_URL=https://platform.eu.happyrobot.ai/api/v2
# OJO: la API de HappyRobot autentica con 'Authorization: Bearer sk_live_...', no con x-api-key.
# El x-api-key de arriba es solo para nuestra API. No cruzar los dos esquemas.
#
# HR_WORKFLOW_WEBHOOK tiene que apuntar a un workflow cuyo nodo RAIZ sea un trigger de webhook
# (webhook.predefined_request). Los workflows con trigger "Workflow Function Request" NO se
# pueden arrancar desde fuera: POST /workflows/:id/runs devuelve 404. Verificado el 19 sep 2026.
# Qué hay que cambiar en el workflow: docs/02-happyrobot/06-trigger-desde-fuera.md

# --- Contexto que el agente de voz lee al descolgar ---
# El prompt los interpola literalmente: un valor vacio se OYE como un hueco en la frase.
CAMPANA_ORGANISMO=Proteccion Civil
CAMPANA_ZONA=su zona
ORDEN_AUTORIDAD=ninguna

# --- Reparto de llamadas (rodear un circulo en Vigia) ---
CALL_PARALLELISM=8                               # llamadas simultaneas por rafaga
CALL_MAX_BATCH=25                                # tope de llamadas por rafaga
CALL_MAX_RADIUS_M=20000                          # radio maximo admitido en /calls/dispatch

# --- Nuestros procesos ---
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=                                 # túnel (ngrok/cloudflared) para que HappyRobot nos alcance
DASHBOARD_PORT=8080
GPS_PORT=8081

# --- Rutas ---
# valhalla es el unico proveedor que sabe esquivar el poligono del fuego (exclude_polygons).
# Google Routes API v2 NO puede: solo evita peajes/autopistas/ferries. straight es el fallback tonto.
ROUTING_PROVIDER=valhalla                        # valhalla | osrm | straight
VALHALLA_URL=http://localhost:8002
OSRM_URL=http://localhost:5000

# --- Escenario ---
SCENARIO=sierra-culebra
TIME_SCALE=60                                    # 1 min simulado = 1 s real

# --- INTERRUPTOR DE SEGURIDAD ---
# En false el sistema SIMULA llamadas y SMS y los registra en el decision_log.
# Se pone a true solo en el momento de la demo, con el dataset sintetico cargado.
# Un bucle que llame de verdad a 120 telefonos arruina el proyecto y algo mas.
ALLOW_REAL_CALLS=false

# --- TELEFONOS REALES DE ENSAYO ---
# Este repo es PUBLICO: ningun movil real puede entrar en un fichero versionado. Los escenarios
# solo llevan numeros del rango reservado +3460099xxxx. Para ensayar contra telefonos de verdad
# se sustituyen aqui, al cargar el escenario:
PHONE_OVERRIDES=                                 # p-001:+34600112233,p-002:+34600445566

# Aqui vivia CALL_ALLOWLIST, una lista blanca de telefonos. Se quito: el agente llama a
# numeros que le dicta la persona durante la conversacion, y eso no cabe en una lista escrita
# de antemano. Los frenos que quedan son ALLOW_REAL_CALLS, CALL_MAX_BATCH y CALL_MAX_RADIUS_M,
# y que los telefonos del escenario son del rango reservado (los reales entran por
# PHONE_OVERRIDES, arriba).

# --- EL ORGANISMO AL QUE LLAMA EL AGENTE ---
# Movil que hace de "mando" / ayuntamiento cuando el agente usa `llamar_a_organismo_oficial`
# en mitad de una llamada. Lo marca HappyRobot, no nosotros. El nodo de la v9 lleva un numero
# fijo y solo usa este si llega, asi que vacio = se queda el fijo del workflow.
DEMO_ORG_PHONE=                                  # +34600778899
