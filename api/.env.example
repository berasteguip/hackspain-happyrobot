# Configuración de la API de estado de crisis. Copia a `api/.env` y rellena.
# Nada de esto es obligatorio: sin fichero .env la API arranca en modo seguro (sin llamadas
# reales, sin auth, rutas en línea recta).

# ======================================================================================
# EL INTERRUPTOR IMPORTANTE
# ======================================================================================
# Con `false` (o sin poner) NADIE recibe llamadas ni SMS de verdad: se simulan, se registran en el
# decision_log y devuelven éxito. Ponlo en `true` SOLO cuando los teléfonos del escenario sean
# vuestros y el workflow de HappyRobot esté probado.
ALLOW_REAL_CALLS=false

# ======================================================================================
# HappyRobot
# ======================================================================================
# Webhook del workflow que dispara la llamada/SMS (la API le hace POST con el payload de la acción).
HR_WORKFLOW_WEBHOOK=
# Clave de HappyRobot (`sk_live_...`). Si empieza por `sk_` se manda como Bearer; si es un
# secreto propio de un receptor de pruebas, como `x-api-key`.
HR_API_KEY=
# Secreto compartido que la API EXIGE en `x-api-key` a quien la llama (HappyRobot, dashboard).
# Si lo dejas vacío la API queda abierta (cómodo en local, no lo dejes así con un túnel público).
HR_SHARED_SECRET=
# Verificado: la plataforma cuelga de /api/v2 y autentica con `Authorization: Bearer sk_live_...`,
# NO con x-api-key (eso es solo de NUESTRA API). No cruzar los dos esquemas.
HR_BASE_URL=https://platform.eu.happyrobot.ai/api/v2

# URL con la que la API se refiere a sí misma en los enlaces que manda por SMS (página de GPS,
# tool `/instructions/{id}`). Si expones la API con un túnel, pon aquí la URL pública.
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=

# ======================================================================================
# Escenario y auditoría
# ======================================================================================
# Nombre del fichero (sin .json) dentro de SCENARIOS_DIR.
SCENARIO=sierra-culebra
SCENARIOS_DIR=../data/scenarios
# Registro de auditoría (append-only). El estado vive en memoria: esto NO se lee al arrancar.
STATE_JSONL=./state.jsonl

# ======================================================================================
# Rutas
# ======================================================================================
# straight | osrm | valhalla   (straight = línea recta, sin red, siempre funciona)
ROUTING_PROVIDER=straight
OSRM_URL=http://localhost:5000
VALHALLA_URL=http://localhost:8002
ROUTING_TIMEOUT_S=3.0
STRAIGHT_SPEED_KMH=45.0
PATROL_SPEED_KMH=55.0

# ======================================================================================
# Umbrales del planner (tocar solo si el escenario lo pide)
# ======================================================================================
CONVOY_COHESION_M=1500.0
POSITION_SIGNIFICANT_MOVE_M=150.0
SAFE_ZONE_FILLING_RATIO=0.8
SAFE_ZONE_THREATENED_M=3000.0
STALLED_MINUTES=5.0
AT_RISK_HORIZON_MIN=10.0
