# Secretos
.env
.env.*
!.env.example

# Datos personales de los ensayos: nombres y móviles reales de gente que no ha firmado
# nada. Este repo es público y el historial de git no se borra. El escenario versionado
# lleva nombres genéricos y el rango reservado +3460099xxxx; lo de verdad vive aquí y lo
# inyecta api/loader.py al arrancar (ROSTER_CSV).
data/private/
**/config.js
!**/config.example.js

# Playwright output (may contain credentials)
.playwright-cli/
.playwright/
.playwright-mcp/

# Node
node_modules/
dist/
*.local

# Python
.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Artefactos de ejecucion
api/state.jsonl
api/tests/.state-*.jsonl
**/build.log
sim/out/
sim/cache/
engine/logs/

# macOS
.DS_Store

# Config local de agentes (no se comparte)
.devin/config.local.json
.devin/mcp_config.local.json

# Mirror de la documentación oficial de HappyRobot.
# Es material del proveedor, que en público está tras un access code: no se
# publica en este repo (que es público). Se distribuye por privado al equipo.
# Regenerar: HR_DOCS_CODE=<access-code> python3 scripts/scrape_docs.py
docs/_inbox/*happyrobot-docs-oficiales/
docs/_inbox/*happyrobot-docs*.zip
happyrobot-docs*.zip
